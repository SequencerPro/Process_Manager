@* Search bar with debounced input *@
@implements IDisposable
<div class="input-group input-group-sm" style="max-width: 300px;">
    <span class="input-group-text"><i class="bi bi-search"></i></span>
    <input type="text" class="form-control" placeholder="@Placeholder"
           value="@Value" @oninput="OnInput" />
    @if (!string.IsNullOrEmpty(Value))
    {
        <button class="btn btn-outline-secondary" type="button" @onclick="Clear">
            <i class="bi bi-x"></i>
        </button>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Placeholder { get; set; } = "Search...";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private System.Timers.Timer? _debounce;
    private bool _disposed;

    private void OnInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        _debounce?.Stop();
        _debounce?.Dispose();
        _debounce = new System.Timers.Timer(300);
        _debounce.Elapsed += async (_, _) =>
        {
            _debounce?.Stop();
            // Elapsed is a sync event, so this lambda is async void: an exception escaping it
            // would crash the process. Hand it to the renderer like any other event handler error.
            try
            {
                await InvokeAsync(() => _disposed ? Task.CompletedTask : ValueChanged.InvokeAsync(val));
            }
            catch (Exception ex)
            {
                await DispatchExceptionAsync(ex);
            }
        };
        _debounce.AutoReset = false;
        _debounce.Start();
    }

    private async Task Clear()
    {
        await ValueChanged.InvokeAsync("");
    }

    public void Dispose()
    {
        // A tick already past Stop() checks _disposed on the dispatcher and is dropped.
        _disposed = true;
        _debounce?.Stop();
        _debounce?.Dispose();
    }
}
